{
  "name": "airstraf-firefox-replacement",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Readable JavaScript replacements for live airstraf.ing in Firefox",
  "scripts": {
    "build:extension": "node tools/build_extension.mjs",
    "test:extension": "node --test tests/extension.test.mjs",
    "build": "node tools/build_readable.mjs",
    "verify": "node tools/verify_readable.mjs && node tools/verify_equivalence.mjs"
  },
  "dependencies": {
    "@babel/generator": "^7.26.9",
    "@babel/parser": "^7.26.9",
    "@babel/traverse": "^7.26.9",
    "@babel/types": "^7.26.9",
    "@jridgewell/gen-mapping": "^0.3.8",
    "@jridgewell/trace-mapping": "^0.3.25"
  }
}
